# ============================================================================
# gatekeeper — all-in-one backend env vars
# Copy to .env.local (gitignored) for local dev, and set the same keys in Vercel.
# ============================================================================

# ─── Business Analyzer Tool (BAT) — EXISTING, already in use ────────────────
# Used by app/api/{submit,check-contact,mark-used} via lib/ghl.ts.
GHL_API_TOKEN=              # GoHighLevel private integration token
GHL_LOCATION_ID=           # GoHighLevel location (sub-account) id

# CORS allowlist, comma-separated. Shared by BAT and the credit analyzer.
# Defaults to "*" if unset (see lib/ghl.ts corsHeaders).
ALLOWED_ORIGINS=           # e.g. https://app.example.com,https://funnel.example.com

# ─── Credit Analyzer — Supabase (Phase 1, ACTIVE) ───────────────────────────
# Server-side only. The service-role key bypasses RLS — never expose to the
# browser. Used by lib/supabase.ts. See docs/credit-analyzer-plan.md §6, §11.
SUPABASE_URL=              # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY= # service_role secret from Supabase project settings

# ─── Credit Analyzer — LLM extraction (Phase 2) ─────────────────────────────
# Provider for PDF extraction: "openrouter" (default, client preference) or
# "openai". See plan §16 (OpenRouter decision + DEFERRED compliance review).
LLM_PROVIDER=openrouter

# OpenRouter (default). Namespaced model ids. ⚠️ Compliance deferred: before real
# PII, enable request-level ZDR + training opt-out + prompt-logging OFF + a pinned
# provider, with legal sign-off (plan §9/§16).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# OpenAI direct (only used when LLM_PROVIDER=openai). Bare model ids.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# When true (or when the active provider's key is unset), /api/analyze returns a
# MOCK extraction so the full pipeline is testable without spending on an LLM.
CREDIT_ANALYZE_MOCK=false

# Mock profile (only applies in mock mode). Unset/"standard" = ~640s Fair scores
# (best-path reaches 700). "low" = ~540s Poor scores → best-path falls short of
# 700, for testing the unreachable-target UI.
CREDIT_MOCK_PROFILE=standard

# Wrong-document pre-check (zero-AI): rejects non-credit-report PDFs before the
# extraction call. Set to "off" only if it ever false-rejects a legit report.
CREDIT_PRECHECK=on
CREDIT_MAX_PAGES=60        # cost/abuse ceiling on PDF page count

# Push analysis fields + used-tag to the GHL contact after a REAL analysis.
# Set to "off" to disable all CRM writes. (Always skipped in mock mode.)
CREDIT_CRM_SYNC=on

# ─── Credit Analyzer — gate + rate limiting (Phase 1–4, NOT WIRED YET) ──────
# Reuses the GHL token/location above; only the tag differs from BAT.
CREDIT_USED_TAG=credit-analyzer-used

# Gate enforcement. OFF by default so the same contact can be tested repeatedly
# without lockout — /api/consent only OBSERVES the gate. Set to "true" in
# production to hard-block repeat use (returns gate_closed). See lib/credit.ts.
CREDIT_GATE_ENFORCED=false

# ─── Phone OTP access gate — Telnyx Verify (docs/otp-access-plan.md) ────────
# Telnyx Portal → API Keys, and Verify → create a Verify Profile → copy its id.
TELNYX_API_KEY=
TELNYX_VERIFY_PROFILE_ID=
OTP_TOKEN_SECRET=          # long random string (e.g. openssl rand -hex 32) — signs verificationToken
OTP_VERIFICATION_TTL_MINUTES=15
# DEV: set OTP_BYPASS=on to skip Telnyx entirely (no US number/SMS needed); the
# fixed OTP_BYPASS_CODE is accepted at /api/otp/verify. Turn OFF for production.
OTP_BYPASS=on
OTP_BYPASS_CODE=000000
# When on, /api/consent requires a valid verificationToken. Keep off during dev.
OTP_REQUIRED=off
OTP_RESEND_COOLDOWN_SEC=45
# Anti SMS-pumping caps (real mode). 0 = disabled.
OTP_RATE_LIMIT_PER_PHONE_DAY=5
OTP_RATE_LIMIT_PER_IP_DAY=15
OTP_GLOBAL_DAY=0

RATE_LIMIT_PER_IP_DAY=     # secondary deterrence (per-IP/day)
RATE_LIMIT_GLOBAL_DAY=     # cost circuit-breaker (global/day)
SWEEP_TTL_MINUTES=         # orphaned-upload cleanup window (plan §4 step 9)
